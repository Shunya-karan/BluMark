PORT=5000
NODE_ENV=development
DATABASE_URL="YOUR_POSTGRESQL_CONNECTION_STRING"
FRONTEND_URL="http://localhost:3000"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER="blumark-api"
JWT_AUDIENCE="blumark-clients"
MAX_PROFILES_PER_INSTITUTION=10000

# Required in production for activation and password-reset delivery
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="replace-me"
SMTP_PASSWORD="replace-me"
SMTP_FROM="Blu-Mark <no-reply@example.com>"

