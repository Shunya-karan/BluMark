generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String
  code                      String                     @unique
  type                      InstitutionType
  email                     String?
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  attendanceRecords         AttendanceRecord[]
  attendanceSessions        AttendanceSession[]
  auditLogs                 AuditLog[]
  classSubjects             ClassSubject[]
  classes                   SchoolClass[]
  departments               Department[]
  deviceReplacementRequests DeviceReplacementRequest[]
  devices                   Device[]
  enrollments               Enrollment[]
  notifications             Notification[]
  profiles                  Profile[]
  studyMaterials            StudyMaterial[]
  subjects                  Subject[]
  timetableSlots            TimetableSlot[]

  @@map("institutions")
}

model Profile {
  id                                String                     @id @db.Uuid
  institutionId                     String                     @map("institution_id") @db.Uuid
  fullName                          String                     @map("full_name")
  email                             String
  phone                             String?
  role                              UserRole
  isActive                          Boolean                    @default(true) @map("is_active")
  createdAt                         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  activationTokens                  AccountActivationToken[]
  attendance                        AttendanceRecord[]         @relation("StudentAttendance")
  sessions                          AttendanceSession[]        @relation("SessionTeacher")
  auditLogs                         AuditLog[]                 @relation("AuditActor")
  authSessions                      AuthSession[]
  taughtSubjects                    ClassSubject[]             @relation("AssignedTeacher")
  deviceReplacementRequests         DeviceReplacementRequest[] @relation("ReplacementRequester")
  reviewedDeviceReplacementRequests DeviceReplacementRequest[] @relation("ReplacementReviewer")
  studentDevices                    Device[]                   @relation("StudentDevices")
  devicesReviewed                   Device[]                   @relation("DeviceReviewer")
  enrollments                       Enrollment[]               @relation("StudentEnrollments")
  receivedNotifications             Notification[]             @relation("NotificationRecipient")
  sentNotifications                 Notification[]             @relation("NotificationSender")
  passwordResetTokens               PasswordResetToken[]
  institution                       Institution                @relation(fields: [institutionId], references: [id])
  studentDetails                    StudentDetail?
  uploadedStudyMaterials            StudyMaterial[]            @relation("MaterialUploader")
  teacherDetails                    TeacherDetail?
  credential                        UserCredential?

  @@unique([id, institutionId])
  @@unique([institutionId, email])
  @@index([institutionId, role])
  @@map("profiles")
}

model UserCredential {
  profileId          String    @id @map("profile_id") @db.Uuid
  emailNormalized    String    @unique @map("email_normalized") @db.VarChar(254)
  passwordHash       String?   @map("password_hash")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(3)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile            Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  profileId         String    @map("profile_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?   @map("revocation_reason") @db.VarChar(64)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([familyId, revokedAt])
  @@index([profileId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, expiresAt])
  @@map("password_reset_tokens")
}

model AccountActivationToken {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, expiresAt])
  @@map("account_activation_tokens")
}

model Department {
  id             String          @id @default(uuid()) @db.Uuid
  institutionId  String          @map("institution_id") @db.Uuid
  name           String
  code           String
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  classes        SchoolClass[]
  institution    Institution     @relation(fields: [institutionId], references: [id])
  teacherDetails TeacherDetail[]

  @@unique([id, institutionId])
  @@unique([institutionId, code])
  @@index([institutionId, isActive])
  @@map("departments")
}

model StudentDetail {
  profileId     String   @id @map("profile_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  studentNumber String   @map("student_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile       Profile  @relation(fields: [profileId, institutionId], references: [id, institutionId])

  @@unique([institutionId, studentNumber])
  @@unique([profileId, institutionId])
  @@map("student_details")
}

model TeacherDetail {
  profileId     String      @id @map("profile_id") @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  departmentId  String?     @map("department_id") @db.Uuid
  employeeId    String      @map("employee_id")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  department    Department? @relation(fields: [departmentId, institutionId], references: [id, institutionId])
  profile       Profile     @relation(fields: [profileId, institutionId], references: [id, institutionId])

  @@unique([institutionId, employeeId])
  @@unique([profileId, institutionId])
  @@index([institutionId, departmentId])
  @@map("teacher_details")
}

model SchoolClass {
  id            String         @id @default(uuid()) @db.Uuid
  institutionId String         @map("institution_id") @db.Uuid
  departmentId  String?        @map("department_id") @db.Uuid
  name          String
  division      String?
  academicYear  String         @map("academic_year")
  semester      Int?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subjects      ClassSubject[]
  department    Department?    @relation(fields: [departmentId, institutionId], references: [id, institutionId])
  institution   Institution    @relation(fields: [institutionId], references: [id])
  enrollments   Enrollment[]

  @@unique([id, institutionId])
  @@unique([institutionId, name, division, academicYear, semester])
  @@index([institutionId, academicYear, isActive])
  @@map("classes")
}

model Subject {
  id            String         @id @default(uuid()) @db.Uuid
  institutionId String         @map("institution_id") @db.Uuid
  name          String
  code          String
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  classes       ClassSubject[]
  institution   Institution    @relation(fields: [institutionId], references: [id])

  @@unique([id, institutionId])
  @@unique([institutionId, code])
  @@index([institutionId, isActive])
  @@map("subjects")
}

model ClassSubject {
  id             String              @id @default(uuid()) @db.Uuid
  institutionId  String              @map("institution_id") @db.Uuid
  classId        String              @map("class_id") @db.Uuid
  subjectId      String              @map("subject_id") @db.Uuid
  teacherId      String              @map("teacher_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions       AttendanceSession[]
  schoolClass    SchoolClass         @relation(fields: [classId, institutionId], references: [id, institutionId])
  institution    Institution         @relation(fields: [institutionId], references: [id])
  subject        Subject             @relation(fields: [subjectId, institutionId], references: [id, institutionId])
  teacher        Profile             @relation("AssignedTeacher", fields: [teacherId, institutionId], references: [id, institutionId])
  studyMaterials StudyMaterial[]
  timetableSlots TimetableSlot[]

  @@unique([id, institutionId])
  @@unique([id, institutionId, teacherId])
  @@unique([classId, subjectId, teacherId])
  @@index([institutionId, teacherId])
  @@map("class_subjects")
}

model Enrollment {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  studentId     String      @map("student_id") @db.Uuid
  classId       String      @map("class_id") @db.Uuid
  enrolledAt    DateTime    @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  isActive      Boolean     @default(true) @map("is_active")
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  schoolClass   SchoolClass @relation(fields: [classId, institutionId], references: [id, institutionId])
  institution   Institution @relation(fields: [institutionId], references: [id])
  student       Profile     @relation("StudentEnrollments", fields: [studentId, institutionId], references: [id, institutionId])

  @@unique([studentId, classId])
  @@index([institutionId, classId, isActive])
  @@index([studentId])
  @@map("enrollments")
}

model Device {
  id                String             @id @default(uuid()) @db.Uuid
  institutionId     String             @map("institution_id") @db.Uuid
  profileId         String             @map("profile_id") @db.Uuid
  deviceIdentifier  String             @map("device_identifier")
  publicKey         String?            @map("public_key")
  status            DeviceStatus       @default(PENDING)
  registeredAt      DateTime           @default(now()) @map("registered_at") @db.Timestamptz(3)
  reviewedBy        String?            @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason   String?            @map("rejection_reason")
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  attendanceRecords AttendanceRecord[]
  institution       Institution        @relation(fields: [institutionId], references: [id])
  student           Profile            @relation("StudentDevices", fields: [profileId, institutionId], references: [id, institutionId])
  reviewer          Profile?           @relation("DeviceReviewer", fields: [reviewedBy, institutionId], references: [id, institutionId])

  @@unique([id, institutionId])
  @@unique([institutionId, deviceIdentifier])
  @@index([institutionId, profileId, status])
  @@index([institutionId, status, registeredAt])
  @@map("devices")
}

model StudyMaterial {
  id               String       @id @default(uuid()) @db.Uuid
  institutionId    String       @map("institution_id") @db.Uuid
  classSubjectId   String       @map("class_subject_id") @db.Uuid
  uploadedBy       String?      @map("uploaded_by") @db.Uuid
  title            String
  description      String?
  fileUrl          String       @map("file_url")
  fileType         String       @map("file_type") @db.VarChar(128)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  fileSize         Int?         @map("file_size")
  originalFileName String?      @map("original_file_name")
  storageKey       String?      @map("storage_key")
  classSubject     ClassSubject @relation(fields: [classSubjectId, institutionId], references: [id, institutionId])
  institution      Institution  @relation(fields: [institutionId], references: [id])
  uploader         Profile?     @relation("MaterialUploader", fields: [uploadedBy, institutionId], references: [id, institutionId])

  @@index([institutionId, classSubjectId, createdAt])
  @@map("study_materials")
}

model Notification {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  recipientId   String      @map("recipient_id") @db.Uuid
  senderId      String?     @map("sender_id") @db.Uuid
  title         String
  body          String
  type          String      @default("GENERAL") @db.VarChar(64)
  readAt        DateTime?   @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id])
  recipient     Profile     @relation("NotificationRecipient", fields: [recipientId, institutionId], references: [id, institutionId])
  sender        Profile?    @relation("NotificationSender", fields: [senderId, institutionId], references: [id, institutionId])

  @@index([institutionId, recipientId, readAt, createdAt])
  @@map("notifications")
}

model DeviceReplacementRequest {
  id                        String                  @id @default(uuid()) @db.Uuid
  institutionId             String                  @map("institution_id") @db.Uuid
  profileId                 String                  @map("profile_id") @db.Uuid
  requestedDeviceIdentifier String                  @map("requested_device_identifier")
  publicKey                 String?                 @map("public_key")
  reason                    String?
  status                    DeviceReplacementStatus @default(PENDING)
  reviewedBy                String?                 @map("reviewed_by") @db.Uuid
  reviewedAt                DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason           String?                 @map("rejection_reason")
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution               Institution             @relation(fields: [institutionId], references: [id])
  requester                 Profile                 @relation("ReplacementRequester", fields: [profileId, institutionId], references: [id, institutionId])
  reviewer                  Profile?                @relation("ReplacementReviewer", fields: [reviewedBy, institutionId], references: [id, institutionId])

  @@index([institutionId, profileId, status, createdAt])
  @@map("device_replacement_requests")
}

model TimetableSlot {
  id             String              @id @default(uuid()) @db.Uuid
  institutionId  String              @map("institution_id") @db.Uuid
  classSubjectId String              @map("class_subject_id") @db.Uuid
  weekday        Int
  startTime      DateTime            @map("start_time") @db.Time(0)
  endTime        DateTime            @map("end_time") @db.Time(0)
  room           String?
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions       AttendanceSession[]
  classSubject   ClassSubject        @relation(fields: [classSubjectId, institutionId], references: [id, institutionId])
  institution    Institution         @relation(fields: [institutionId], references: [id])

  @@unique([id, institutionId])
  @@index([institutionId, weekday, isActive])
  @@index([classSubjectId, weekday])
  @@map("timetable_slots")
}

model AttendanceSession {
  id              String             @id @default(uuid()) @db.Uuid
  institutionId   String             @map("institution_id") @db.Uuid
  classSubjectId  String             @map("class_subject_id") @db.Uuid
  teacherId       String             @map("teacher_id") @db.Uuid
  timetableSlotId String?            @map("timetable_slot_id") @db.Uuid
  sessionCode     String             @map("session_code")
  bleTokenSeed    String             @map("ble_token_seed")
  status          SessionStatus      @default(ACTIVE)
  startsAt        DateTime           @default(now()) @map("starts_at") @db.Timestamptz(3)
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz(3)
  endedAt         DateTime?          @map("ended_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  records         AttendanceRecord[]
  classSubject    ClassSubject       @relation(fields: [classSubjectId, institutionId, teacherId], references: [id, institutionId, teacherId])
  institution     Institution        @relation(fields: [institutionId], references: [id])
  teacher         Profile            @relation("SessionTeacher", fields: [teacherId, institutionId], references: [id, institutionId])
  timetableSlot   TimetableSlot?     @relation(fields: [timetableSlotId, institutionId], references: [id, institutionId])

  @@unique([id, institutionId])
  @@unique([institutionId, sessionCode])
  @@index([institutionId, status, expiresAt])
  @@index([teacherId, startsAt])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id            String            @id @default(uuid()) @db.Uuid
  institutionId String            @map("institution_id") @db.Uuid
  sessionId     String            @map("session_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  deviceId      String?           @map("device_id") @db.Uuid
  status        AttendanceStatus  @default(PRESENT)
  method        AttendanceMethod  @default(BLE)
  markedAt      DateTime          @default(now()) @map("marked_at") @db.Timestamptz(3)
  rssi          Int?              @db.SmallInt
  notes         String?
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  device        Device?           @relation(fields: [deviceId, institutionId], references: [id, institutionId])
  institution   Institution       @relation(fields: [institutionId], references: [id])
  session       AttendanceSession @relation(fields: [sessionId, institutionId], references: [id, institutionId])
  student       Profile           @relation("StudentAttendance", fields: [studentId, institutionId], references: [id, institutionId])

  @@unique([sessionId, studentId])
  @@index([institutionId, studentId, markedAt])
  @@index([institutionId, sessionId, status])
  @@map("attendance_records")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  actorId       String?     @map("actor_id") @db.Uuid
  action        String
  entityType    String      @map("entity_type")
  entityId      String?     @map("entity_id") @db.Uuid
  details       Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  actor         Profile?    @relation("AuditActor", fields: [actorId, institutionId], references: [id, institutionId])
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId, createdAt])
  @@index([institutionId, entityType, entityId])
  @@map("audit_logs")
}

enum InstitutionType {
  SCHOOL
  UNIVERSITY

  @@map("institution_type")
}

enum UserRole {
  INSTITUTION_ADMIN
  TEACHER
  STUDENT

  @@map("user_role")
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("session_status")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED

  @@map("attendance_status")
}

enum AttendanceMethod {
  BLE
  MANUAL
  ADMIN_OVERRIDE

  @@map("attendance_method")
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED

  @@map("device_status")
}

enum DeviceReplacementStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("device_replacement_status")
}
